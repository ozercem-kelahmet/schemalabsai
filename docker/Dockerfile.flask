FROM python:3.11-slim
WORKDIR /app/model
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY model/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir torch==2.5.1+cu121 torchvision==0.20.1+cu121 --index-url https://download.pytorch.org/whl/cu121
COPY model/ ./
RUN mkdir -p /app/finetuned_models /app/checkpoints /app/uploads
EXPOSE 6000
HEALTHCHECK --interval=30s --timeout=15s --start-period=45s --retries=3 \
  CMD curl -f http://localhost:6000/health || exit 1
CMD ["python", "server.py"]

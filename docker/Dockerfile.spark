FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl default-jdk-headless procps \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
RUN java_path=$(readlink -f $(which java) | sed "s|/bin/java||") && \
    echo "JAVA_HOME=$java_path" >> /etc/environment && \
    ln -sfn $java_path /usr/lib/jvm/java-17-openjdk-amd64 2>/dev/null || true

RUN pip install --no-cache-dir \
    pyspark==3.5.0 \
    kafka-python==2.0.2 \
    flask==3.0.0 \
    gunicorn==21.2.0 \
    pandas==2.1.0 \
    pymongo==4.6.0 \
    psycopg2-binary==2.9.9 \
    pymysql==1.1.0 \
    snowflake-connector-python==3.6.0 \
    google-cloud-storage==2.13.0 \
    boto3==1.34.0 \
    "numpy<2.0"

RUN curl -L -o /usr/local/lib/python3.11/site-packages/pyspark/jars/gcs-connector-hadoop3-shaded.jar \
    "https://repo1.maven.org/maven2/com/google/cloud/bigdataoss/gcs-connector/hadoop3-2.2.22/gcs-connector-hadoop3-2.2.22-shaded.jar"

COPY services/spark_app/ /app/

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "--timeout", "300", "app:app"]
